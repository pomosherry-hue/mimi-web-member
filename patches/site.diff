@@ -0,0 +1,23 @@
+/* 兑换码 / 会员集（草稿） */
+.lock-panel {
+  margin: 16px 0; padding: 24px 18px; text-align: center;
+  background: #fff; border: 1px solid var(--line); border-radius: 24px; box-shadow: var(--shadow);
+}
+.lock-panel h2 { margin: 6px 0; font-size: 22px; }
+.lock-panel p { color: var(--muted); margin: 6px 0; }
+.lock-icon { font-size: 44px; }
+.redeem-form { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin: 14px 0 6px; }
+.redeem-input {
+  font-size: 20px; letter-spacing: 0.08em; text-transform: uppercase; text-align: center;
+  padding: 12px 14px; border: 2px solid var(--line); border-radius: 14px; width: min(320px, 100%);
+}
+.redeem-input:focus { outline: none; border-color: var(--c); }
+.redeem-msg { min-height: 1.6em; font-weight: 700; color: var(--ink); }
+.lock-buy { font-size: 14px; }
+.card .locked { color: #9a6b1f; font-weight: 700; }
+.swatch .lock-badge {
+  position: absolute; right: 8px; top: 8px; z-index: 2;
+  background: rgba(255,255,255,.9); border-radius: 999px; padding: 2px 8px; font-size: 13px;
+}
+.member-bar { font-size: 13px; color: var(--muted); margin: 6px 0; }
+.member-bar button { font-size: 13px; background: none; border: 0; color: var(--muted); text-decoration: underline; cursor: pointer; }
